# 推荐：使用本机 Codex CLI 的 ChatGPT 会员登录
AI_PROVIDER=codex
CODEX_PATH=codex
CODEX_MODEL=gpt-5.4
CODEX_TIMEOUT_MS=600000

# 备选：改为 AI_PROVIDER=openai 后使用 API
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2

# 微信公众号：在公众平台「设置与开发 → 基本配置」获取
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 服务
HOST=127.0.0.1
PORT=3210
APP_BASE_URL=http://localhost:3210
